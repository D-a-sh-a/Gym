<!DOCTYPE html>
<html lang="uk">

<head>
    <meta charset="UTF-8">
    <title>Кабінет Клієнта</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="/css/style.css">
    <script src='https://cdn.jsdelivr.net/npm/fullcalendar@6.1.8/index.global.min.js'></script>
</head>

<body class="bg-light d-flex flex-column min-vh-100">
    {{> menu}}
    <div class="container pb-5">
        <div class="d-flex flex-wrap justify-content-between align-items-center mb-4 gap-2">
            <h2 class="mb-0">Ваші заплановані тренування</h2>
            <div class="d-flex align-items-center gap-3">
                <span class="badge bg-info text-dark fs-6 py-2 px-3">💰 Баланс: {{depositBalance}} грн</span>
                <button class="btn btn-success shadow fw-bold" data-bs-toggle="modal" data-bs-target="#addBookingModal">
                    + Записатись на тренування
                </button>
            </div>
        </div>

        <div id='calendar' data-events='{{{eventsJson}}}'></div>
    </div>

    <div class="modal fade" id="addBookingModal" tabindex="-1">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header bg-success text-white">
                    <h5 class="modal-title">Запис на персональне тренування</h5>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <form action="/client/add-booking" method="POST">
                        <div class="mb-3">
                            <label class="fw-bold">Тренер</label>
                            <select name="trainer_id" id="addTrainer" class="form-select" required>
                                <option value="" disabled selected>Оберіть тренера</option>
                                {{#each trainersList}}
                                <option value="{{this.id}}">{{this.full_name}}</option>
                                {{/each}}
                            </select>
                        </div>

                        <div class="mb-3">
                            <label class="fw-bold">Послуга</label>
                            <select name="price_id" id="addPrice" class="form-select" required>
                                {{#each pricesList}}
                                <option value="{{this.id}}" data-cost="{{this.cost}}">{{this.title}} — {{this.cost}} грн
                                </option>
                                {{/each}}
                            </select>
                        </div>

                        <div class="row mb-3">
                            <div class="col-6">
                                <label class="fw-bold">Дата</label>
                                <input type="date" name="start_date" id="addDate" class="form-control" required>
                            </div>
                            <div class="col-6">
                                <label class="fw-bold">Вільний час</label>
                                <select name="start_time" id="addTime" class="form-select" required disabled>
                                    <option value="">Оберіть тренера і дату</option>
                                </select>
                            </div>
                        </div>

                        <div class="mb-4">
                            <label class="fw-bold">Спосіб оплати</label>
                            <select name="payment_option" id="addPaymentOption" class="form-select" required>
                                <option value="later">🏢 Оплатити при візиті</option>
                                <option value="online">💳 Оплатити онлайн зараз</option>
                                <option value="balance" id="addBalanceOpt">💰 Списати з балансу ({{depositBalance}} грн)
                                </option>
                            </select>
                        </div>

                        <button type="submit" class="btn btn-success w-100 fw-bold">Підтвердити запис</button>
                    </form>
                </div>
            </div>
        </div>
    </div>

    <div class="modal fade" id="viewModal" tabindex="-1">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header bg-dark-custom text-white">
                    <h5 class="modal-title">Деталі тренування</h5>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <p class="mb-1"><strong>Тренер:</strong> <span id="viewTrainer"></span></p>
                    <p class="mb-1"><strong>Послуга:</strong> <span id="viewService"></span> (<span
                            id="viewCost"></span> грн)</p>
                    <p class="mb-1"><strong>Статус:</strong> <span id="viewStatusBadge" class="badge"></span></p>
                    <p class="mb-3"><strong>Оплата:</strong> <span id="viewPayBadge" class="badge"></span></p>

                    <div id="clientManageBlock">
                        <hr>
                        <form action="/client/edit-booking" method="POST">
                            <input type="hidden" name="booking_id" id="editBookingId">
                            <input type="hidden" name="trainer_id" id="editTrainerId">
                            <label class="fw-bold mb-2">Перенести дату / час:</label>
                            <div class="row mb-3">
                                <div class="col-6">
                                    <input type="date" name="new_date" id="editDate" class="form-control" required>
                                </div>
                                <div class="col-6">
                                    <select name="new_time" id="editTime" class="form-select" required></select>
                                </div>
                            </div>
                            <div class="d-flex justify-content-between">
                                <button type="submit" class="btn btn-outline-success">💾 Перенести</button>
                                <button type="submit" formaction="/client/cancel-booking" class="btn btn-danger"
                                    onclick="return confirm('Скасувати запис? Якщо до початку більше 12 годин, оплата повернеться на ваш баланс.')">
                                    ❌ Скасувати
                                </button>
                            </div>
                        </form>
                    </div>
                </div>
            </div>
        </div>
    </div>

    {{> footer}}
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    <script>
        const clientBalance = Number("{{depositBalance}}") || 0;

        async function loadSlots(trainerId, date, selectEl, currentVal = '', excludeId = '') {
            if (!trainerId || !date) {
                selectEl.innerHTML = '<option value="">Оберіть тренера і дату</option>';
                selectEl.disabled = true;
                return;
            }
            selectEl.innerHTML = '<option value="">Завантаження...</option>';
            selectEl.disabled = true;

            const url = `/api/client/available-slots?trainer_id=${trainerId}&date=${date}${excludeId ? `&exclude_booking_id=${excludeId}` : ''}`;
            const res = await fetch(url);
            const slots = await res.json();

            selectEl.innerHTML = '';
            if (slots.length === 0) {
                selectEl.innerHTML = '<option value="">Немає вільних годин</option>';
                selectEl.disabled = true;
            } else {
                slots.forEach(t => {
                    const opt = document.createElement('option');
                    opt.value = t;
                    opt.textContent = t;
                    if (t === currentVal) opt.selected = true;
                    selectEl.appendChild(opt);
                });
                selectEl.disabled = false;
            }
        }

        document.addEventListener('DOMContentLoaded', function () {
            const todayStr = new Date().toLocaleDateString('en-CA');
            const addDate = document.getElementById('addDate');
            const addTrainer = document.getElementById('addTrainer');
            const addTime = document.getElementById('addTime');
            const addPrice = document.getElementById('addPrice');
            const addBalanceOpt = document.getElementById('addBalanceOpt');

            addDate.min = todayStr;
            document.getElementById('editDate').min = todayStr;

            function updateBalanceOption() {
                const selectedOpt = addPrice.options[addPrice.selectedIndex];
                const cost = selectedOpt ? Number(selectedOpt.dataset.cost || 0) : 0;
                addBalanceOpt.disabled = clientBalance < cost;
                addBalanceOpt.textContent = clientBalance >= cost
                    ? `💰 Списати з балансу (${clientBalance} грн)`
                    : `💰 Недостатньо на балансі (${clientBalance} грн)`;
            }
            updateBalanceOption();
            addPrice.addEventListener('change', updateBalanceOption);

            addTrainer.addEventListener('change', () => loadSlots(addTrainer.value, addDate.value, addTime));
            addDate.addEventListener('change', () => loadSlots(addTrainer.value, addDate.value, addTime));

            const editDate = document.getElementById('editDate');
            const editTime = document.getElementById('editTime');
            editDate.addEventListener('change', () => {
                loadSlots(document.getElementById('editTrainerId').value, editDate.value, editTime, '', document.getElementById('editBookingId').value);
            });

            var calendarEl = document.getElementById('calendar');
            var myEvents = JSON.parse(calendarEl.dataset.events || '[]');

            var calendar = new FullCalendar.Calendar(calendarEl, {
                initialView: 'timeGridWeek',
                businessHours: [
                    { daysOfWeek: [1, 2, 3, 4, 5], startTime: '08:00', endTime: '22:00' },
                    { daysOfWeek: [6], startTime: '09:00', endTime: '21:00' },
                    { daysOfWeek: [0], startTime: '10:00', endTime: '18:00' }
                ],
                locale: 'uk',
                firstDay: 1,
                buttonText: { today: 'Сьогодні', month: 'Місяць', week: 'Тиждень', day: 'День' },
                headerToolbar: { left: 'prev,next today', center: 'title', right: 'timeGridWeek,timeGridDay' },
                slotMinTime: '08:00:00',
                slotMaxTime: '22:00:00',
                allDaySlot: false,
                height: 'auto',
                events: myEvents,
                displayEventTime: false,
                eventClick: function (info) {
                    var props = info.event.extendedProps;
                    document.getElementById('viewTrainer').textContent = props.trainer;
                    document.getElementById('viewService').textContent = props.service;
                    document.getElementById('viewCost').textContent = props.cost;

                    const statusMap = {
                        scheduled: ['Заплановано', 'bg-primary'],
                        attended: ['Відвідано', 'bg-success'],
                        no_show: ['Неявка', 'bg-danger']
                    };
                    const st = statusMap[props.status] || [props.status, 'bg-secondary'];
                    const stBadge = document.getElementById('viewStatusBadge');
                    stBadge.textContent = st[0];
                    stBadge.className = 'badge ' + st[1];

                    const payMap = {
                        unpaid: ['Не оплачено', 'bg-warning text-dark'],
                        paid_online: ['Оплачено онлайн', 'bg-success'],
                        paid_from_balance: ['Оплачено з балансу', 'bg-success'],
                        paid_at_desk: ['Оплачено на рецепції', 'bg-success']
                    };
                    const pm = payMap[props.paymentStatus] || [props.paymentStatus, 'bg-secondary'];
                    const payBadge = document.getElementById('viewPayBadge');
                    payBadge.textContent = pm[0];
                    payBadge.className = 'badge ' + pm[1];

                    const isScheduled = props.status === 'scheduled';
                    document.getElementById('clientManageBlock').style.display = isScheduled ? 'block' : 'none';

                    if (isScheduled) {
                        document.getElementById('editBookingId').value = info.event.id;
                        document.getElementById('editTrainerId').value = props.trainerId;
                        editDate.value = props.dateOnly;
                        loadSlots(props.trainerId, props.dateOnly, editTime, props.timeOnly, info.event.id);
                    }

                    new bootstrap.Modal(document.getElementById('viewModal')).show();
                }
            });
            calendar.render();
        });
    </script>
</body>

</html>