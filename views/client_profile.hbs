<!DOCTYPE html>
<html lang="uk">

<head>
  <meta charset="UTF-8">
  <title>Особистий кабінет</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
  <link rel="stylesheet" href="/css/style.css">
</head>

<body class="bg-light d-flex flex-column min-vh-100">
  {{> menu}}

  <div class="container mt-5 mb-5">
    <div class="row justify-content-center">
      <div class="col-md-8 col-lg-6">
        <div class="card shadow-lg border-0">
          <div class="card-header bg-dark-custom text-white text-center py-3">
            <h3 class="mb-0">Особистий кабінет</h3>
          </div>
          <div class="card-body p-4">
            
            <h5 class="text-muted mb-3">Ваші дані:</h5>
            <ul class="list-group list-group-flush mb-4">
              <li class="list-group-item d-flex justify-content-between align-items-center">
                <strong>ПІБ:</strong>
                <span>{{clientInfo.full_name}}</span>
              </li>
              <li class="list-group-item d-flex justify-content-between align-items-center">
                <strong>Email:</strong>
                <span>{{clientInfo.email}}</span>
              </li>
            </ul>

            <div class="text-center mb-4 p-3 bg-light rounded border">
                <p class="text-muted mb-2 small">Ваш персональний штрихкод для входу:</p>
                <img src="https://barcode.tec-it.com/barcode.ashx?data={{clientInfo.barcode}}&code=Code128&dpi=96" alt="Штрихкод" class="img-fluid bg-white p-2 border rounded">
            </div>

            <h5 class="text-muted mb-3">Статус абонемента:</h5>
            <div class="alert {{#if subscription}}alert-success{{else}}alert-warning{{/if}} text-center" role="alert">
              {{#if subscription}}
              <h4 class="alert-heading">{{subscription.title}}</h4>
              <p class="mb-0">Діє до: <strong>{{subscription.date}}</strong></p>
              {{else}}
              <strong>Немає активного абонемента</strong>
              <br>
              <a href="/price" class="alert-link">Переглянути прайс</a>
              {{/if}}
            </div>
            
            <div class="d-grid gap-2 mt-4">
              <button type="button" class="btn btn-success" onclick="openClientBuyModal()">
                💳 Купити абонемент онлайн
              </button>
              <button type="button" class="btn btn-outline-secondary" data-bs-toggle="modal" data-bs-target="#passwordModal">
                🔒 Змінити пароль
              </button>
            </div>

          </div>
        </div>
      </div>
    </div>
  </div>

  <div class="modal fade" id="clientBuyModal" tabindex="-1">
    <div class="modal-dialog">
      <div class="modal-content">
        <div class="modal-header bg-success text-white">
          <h5 class="modal-title">Придбання абонемента</h5>
          <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
        </div>
        <div class="modal-body">
          <form action="/client/buy" method="POST">
            <label class="form-label fw-bold">Оберіть послугу:</label>
            <select name="price_id" id="clientPriceSelect" class="form-select mb-4" required>
            </select>
            <input type="hidden" name="payment_method" value="card">
            <button type="submit" class="btn btn-success w-100">Перейти до оплати</button>
          </form>
        </div>
      </div>
    </div>
  </div>

  <div class="modal fade" id="passwordModal" tabindex="-1">
    <div class="modal-dialog">
      <div class="modal-content">
        <div class="modal-header bg-dark-custom text-white">
          <h5 class="modal-title">Зміна пароля</h5>
          <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
        </div>
        <div class="modal-body">
          <form action="/client/change-password" method="POST">
            <div class="mb-3">
              <label class="form-label fw-bold">Новий пароль</label>
              <input type="password" name="new_password" class="form-control" required minlength="6">
            </div>
            <div class="mb-3">
              <label class="form-label fw-bold">Повторіть пароль</label>
              <input type="password" name="confirm_password" class="form-control" required minlength="6">
            </div>
            <div class="d-flex justify-content-between mt-4">
              <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Відмінити</button>
              <button type="submit" class="btn btn-primary-custom">Підтвердити</button>
            </div>
          </form>
        </div>
      </div>
    </div>
  </div>

  {{> footer}}
  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
  
  <script>
    const allPrices = {{{pricesJson}}};
    const hasPurchase = {{hasPurchase}};
    const discount = {{discount}};

    function openClientBuyModal() {
      const select = document.getElementById('clientPriceSelect');
      select.innerHTML = '';

      allPrices.forEach(item => {
        const titleLower = (item.title || '').toLowerCase();
        const durationLower = (item.duration || '').toLowerCase();
        const isSingleVisit = titleLower.includes('разов') || durationLower.includes('день');

        if (isSingleVisit) return;

        const option = document.createElement('option');
        option.value = item.id;

        if (!isSingleVisit && discount > 0) {
          const finalCost = Math.max(0, Number(item.cost) - discount);
          option.textContent = `${item.title} — ${finalCost} грн (Ваша знижка -${discount} грн)`;
        } else {
          option.textContent = `${item.title} — ${item.cost} грн`;
        }

        select.appendChild(option);
      });

      new bootstrap.Modal(document.getElementById('clientBuyModal')).show();
    }
  </script>
</body>
</html>